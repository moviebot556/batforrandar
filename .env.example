# ==========================================
# BITCOIN KEY SCANNER ENVIRONMENT TEMPLATE
# ==========================================

# Port for Live Dashboard & Healthcheck
PORT=8080

# Compute Resource Limits
# Render Free Tier: WORKERS=1, MAX_VCPU=0.1
# Railway: WORKERS=2, MAX_VCPU=1.9
WORKERS=1
MAX_VCPU=0.1

# ==========================================
# SCANNING MODE CONFIGURATION
# ==========================================

# Option A: Puzzle Bit Range (e.g. 66 for puzzle #66)
PUZZLE_BITS=66

# Option B: Custom Hex Range
# KEY_RANGE_MIN=0x20000000000000000
# KEY_RANGE_MAX=0x3fffffffffffffffff

# Option C: Full 256-bit Random Keyspace
# (Leave PUZZLE_BITS and KEY_RANGE_MIN/MAX commented out)

# ==========================================
# TARGET ADDRESSES
# ==========================================
ADDRESSES_FILE=addresses.txt
# TARGET_ADDRESSES=13zb1hQbWVsc2S7ZTGarKFbe9M8UbUm2Yea

# ==========================================
# TELEGRAM NOTIFICATIONS (Optional)
# ==========================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
